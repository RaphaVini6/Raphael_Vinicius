# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git - never commit real keys.
# .NET settings use "__" for nesting (Speech__Knowlez__Key = Speech:Knowlez:Key in appsettings.json).

# ---------------------------------------------------------------------------
# Environment: Development | Homologation | Production
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# backend (port 5000)
# ---------------------------------------------------------------------------
# URLs of the other services
Apis__VLibras__BaseUrl=http://localhost:5001
Apis__Speech__BaseUrl=http://localhost:5002
# Frontend origins allowed by CORS (add more with __1, __2...)
Cors__Origins__0=http://localhost:5173

# ---------------------------------------------------------------------------
# api-1-vlibras (port 5001)
# ---------------------------------------------------------------------------
VLibras__BaseUrl=https://traducao2.vlibras.gov.br
# Optional - only needed for the video and /signs endpoints (Conecta gov.br credentials)
VLibras__Token=

# ---------------------------------------------------------------------------
# api-2-speech (port 5002)
# ---------------------------------------------------------------------------
# Knowlez TTS key (https://api-tts.knowlez.com) - main speech engine
Speech__Knowlez__Key=
Speech__Knowlez__BaseUrl=https://api-tts.knowlez.com
# Azure Speech - optional second engine
Speech__Azure__Key=
Speech__Azure__Region=brazilsouth
# Folder where generated audio is cached (relative to api-2-speech)
Speech__CacheDir=audio-cache

# ---------------------------------------------------------------------------
# frontend (port 5173)
# ---------------------------------------------------------------------------
# Backend URL. Leave empty in development (Vite proxies /api to localhost:5000).
VITE_API_URL=
